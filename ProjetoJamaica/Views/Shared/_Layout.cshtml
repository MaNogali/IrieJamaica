<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoJamaica</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjetoJamaica.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white justify-content-center p-3">
            <div class="container d-flex align-items-center justify-content-between">
                <div class="logoNome">
                    <img src="~/assets/img/logo.png" class="logo">
                     <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Irie Jamaica</a>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class=" collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Historia">História</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Cultura">Cultura</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Culinaria">Culinária</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Festivais">Festivais</a>
                        </li>
                         <li class="nav-item">
                            <a class="btn btn-primary rounded-pill" asp-area="" asp-controller="Home" asp-action="Login">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

        <footer class="site-footer border-top footer text-muted" id="footer">
            <div class="container">
                <div class="footer-top">
                    <div class="footer-brand">
                        <a href="index.html" class="nav-logo">
                            <span class="nav-logo-bars">
                                <span></span><span></span><span></span>
                            </span>
                            <span class="nav-logo-text">Irie Jamaica</span>
                        </a>
                        <p>
                            Seu guia para a ilha mais vibrante do Caribe. Descubra as praias,
                            a cultura, a culinária e os festivais da Jamaica.
                        </p>
                        <span class="footer-email">iriejamaica.contato@email.com</span>
                        <div class="footer-socials">
                            <a href="#" aria-label="Instagram">◎</a>
                            <a href="#" aria-label="Facebook">f</a>
                            <a href="#" aria-label="X">✕</a>
                        </div>
                    </div>
                    <div class="footer-columns">
                        <div class="footer-col">
                            <h4>Explore</h4>
                            <ul>
                                <li><a href="index.html">Home</a></li>
                                <li>
                                    <a  asp-area="" asp-controller="Home" asp-action="Historia">História</a>
                                </li>
                                <li>
                                    <a asp-area="" asp-controller="Home" asp-action="Cultura">Cultura</a>
                                </li>
                                <li>
                                    <a  asp-area="" asp-controller="Home" asp-action="Culinaria">Culinária</a>
                                </li>
                            </ul>
                        </div>
                        <div class="footer-col">
                            <h4>Festivais</h4>
                            <ul>
                                <li><a  asp-area="" asp-controller="Home" asp-action="Festivais">Semana Bob Marley</a></li>
                                <li><a  asp-area="" asp-controller="Home" asp-action="Festivais">Ocho Rios</a></li>
                                <li><a  asp-area="" asp-controller="Home" asp-action="Festivais">Reggae Sumfest</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="footer-bottom">
                    © 2026 Irie Jamaica. Todos os direitos reservados.
                </div>
            </div>
        </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
